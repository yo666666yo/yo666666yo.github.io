<%
  const masthead = theme.masthead || {};
  const siteMeta = theme.site || {};
  const displayAuthor = (theme.author && theme.author.name) || config.author || 'Yoyo_Lee';

  function formatNumber(value) {
    return String(value).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
  }

  function keepLatinHyphens(value) {
    return String(value || '').replace(/[A-Za-z0-9]+(?:-[A-Za-z0-9]+)+/g, function (term) {
      return term.length <= 18 ? term.replace(/-/g, '\u2011') : term;
    });
  }

  function escapeHtml(value) {
    return String(value || '').replace(/[&<>"']/g, function (char) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char];
    });
  }

  function formatCjk(value) {
    const text = String(value || '').replace(/\s+\u00b7\s+/g, '\u00a0\u00b7\u00a0');
    if (typeof Intl === 'undefined' || !Intl.Segmenter) return escapeHtml(text);
    try {
      const segmenter = new Intl.Segmenter('zh', { granularity: 'word' });
      const output = [];
      let pending = '';
      function flush() {
        if (pending) output.push('<span class="title-word">' + escapeHtml(pending) + '</span>');
        pending = '';
      }
      Array.from(segmenter.segment(text)).forEach(function (part) {
        const safe = escapeHtml(part.segment);
        const isCjk = part.isWordLike && /[\u3400-\u9fff]/.test(part.segment);
        if (isCjk && part.segment.length <= 6) {
          if (pending.length && pending.length + part.segment.length > 6) flush();
          pending += part.segment;
        } else {
          flush();
          output.push(isCjk ? '<span class="title-word">' + safe + '</span>' : safe);
        }
      });
      flush();
      return output.join('');
    } catch (error) {
      return escapeHtml(text);
    }
  }

  function formatTitle(value) {
    const text = String(value || '');
    const termPattern = /\d{4}\.\d{2}\.\d{2}(?:[\u2013-]\d{2}\.\d{2})?(?:\s+\u00b7)?|[A-Za-z0-9]+(?:-[A-Za-z0-9]+)+/g;
    const output = [];
    let cursor = 0;
    let match;
    while ((match = termPattern.exec(text))) {
      output.push(formatCjk(text.slice(cursor, match.index)));
      const className = /^\d/.test(match[0]) ? 'title-date' : 'title-latin-term';
      const visible = className === 'title-date' ? match[0] : keepLatinHyphens(match[0]);
      if (className === 'title-date') {
        const separator = /\s+\u00b7$/.exec(visible);
        const dateText = separator ? visible.slice(0, -separator[0].length) : visible;
        output.push(separator
          ? '<span class="title-date-group"><span class="title-date">' + escapeHtml(dateText) + '</span><span class="title-separator"> \u00b7</span></span>'
          : '<span class="title-date">' + escapeHtml(dateText) + '</span>');
      } else {
        output.push('<span class="title-latin-term">' + escapeHtml(visible) + '</span>');
      }
      cursor = termPattern.lastIndex;
    }
    output.push(formatCjk(text.slice(cursor)));
    return output.join('');
  }

  function stripForWordCount(value) {
    return String(value || '')
      .replace(/^---[\s\S]*?---/, ' ')
      .replace(/(^|\n)```[^\n]*(?=\n)/g, ' ')
      .replace(/(^|\n)```\s*(?=\n|$)/g, ' ')
      .replace(/(^|\n)~~~[^\n]*(?=\n)/g, ' ')
      .replace(/(^|\n)~~~\s*(?=\n|$)/g, ' ')
      .replace(/\$\$[\s\S]*?\$\$/g, ' ')
      .replace(/\$[^$\n]+\$/g, ' ')
      .replace(/<script[\s\S]*?<\/script>/gi, ' ')
      .replace(/<style[\s\S]*?<\/style>/gi, ' ')
      .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
      .replace(/\[([^\]]+)]\([^)]+\)/g, '$1')
      .replace(/<[^>]+>/g, ' ')
      .replace(/&(?:nbsp|amp|lt|gt|quot|#39);/g, ' ')
      .replace(/[`*_~>#|[\](){}:;,.!?'"“”‘’。，！？、；：]/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function getPostStats() {
    const source = page._content || page.raw || page.content || '';
    const text = stripForWordCount(source);
    const cjkCount = (text.match(/[\u3400-\u9fff\uf900-\ufaff]/g) || []).length;
    const latinCount = (text.replace(/[\u3400-\u9fff\uf900-\ufaff]/g, ' ').match(/[A-Za-z0-9]+(?:[._+-][A-Za-z0-9]+)*/g) || []).length;
    const wordCount = cjkCount + latinCount;

    return {
      wordCount: wordCount,
      readingMinutes: Math.max(1, Math.ceil(wordCount / 400))
    };
  }

  function pickBg() {
    if (page.cover) return page.cover;
    if (page.top_img) return page.top_img;
    if (page.masthead) return page.masthead;

    const wp = theme.wallpapers || {};

    if (is_post()) return masthead.post_bg || masthead.default_bg;
    if (page.type === 'about') return wp.about || masthead.about_bg || masthead.default_bg;

    if (is_category()) {
      const cat = page.category || '';
      if ((cat === '研究' || cat === 'research') && wp.research) return wp.research;
      if ((cat === '生活' || cat === 'life') && wp.life) return wp.life;
      if ((cat === '周报' || cat === 'weekly') && wp.weekly) return wp.weekly;
      return wp.archive || masthead.archive_bg || masthead.default_bg;
    }

    if (is_archive() || page.type === 'categories') {
      return wp.archive || masthead.archive_bg || masthead.default_bg;
    }

    if (is_tag() || page.type === 'tags') {
      return wp.tags || masthead.archive_bg || masthead.default_bg;
    }

    // Homepage — pool[0] as initial bg; JS randomizes on load
    if (is_home() && page.current === 1) {
      if (wp.pool && wp.pool.length) return wp.pool[0];
      return masthead.default_bg || '/img/home-bg.svg';
    }

    return masthead.default_bg || '/img/home-bg.svg';
  }

  const bg = pickBg();
  const fallbackBg = (function() {
    if (is_post()) return masthead.post_bg || masthead.default_bg;
    if (page.type === 'about') return masthead.about_bg || masthead.default_bg;
    if (is_archive() || is_category() || is_tag() || page.type === 'categories' || page.type === 'tags') {
      return masthead.archive_bg || masthead.default_bg;
    }
    return masthead.default_bg || '/img/masthead/home.jpg';
  })();
  const bgIsRemote = bg && /^https?:\/\//.test(bg);
  const isHomePage1 = is_home() && page.current === 1;
  let kind;
  if (is_post()) kind = 'post';
  else if (is_home()) kind = 'site';
  else kind = 'page';

  // heading / subheading / meta
  let heading, subheading, metaLine;
  const postStats = is_post() ? getPostStats() : null;
  if (kind === 'post') {
    heading = page.title;
    subheading = page.description || '';
  } else if (kind === 'site' && page.current > 1) {
    heading = config.title;
    subheading = '';
  } else if (kind === 'site') {
    heading = config.title;
    subheading = siteMeta.subheading || config.subtitle || '';
  } else if (page.type === 'archives' || page.archive) {
    heading = page.title || __('archive.title');
    subheading = page.description || '';
  } else if (page.type === 'categories') {
    heading = page.title || __('categories.title');
    subheading = page.description || '';
  } else if (page.type === 'tags') {
    heading = page.title || __('tags.title');
    subheading = page.description || '';
  } else if (is_category()) {
    heading = page.category || page.title;
    subheading = page.description || '';
  } else if (is_tag()) {
    heading = page.tag || page.title;
    subheading = page.description || '';
  } else {
    heading = page.title || config.title;
    subheading = page.description || page.subtitle || '';
  }
%>
<% if (bg && !isHomePage1) { %><img src="<%- url_for(bg) %>" alt="" style="display:none" aria-hidden="true"><% } %>
<header class="masthead masthead-<%= kind %>"<% if (bg && !isHomePage1) { %> style="background-image: url('<%- url_for(bg) %>')<% if (bgIsRemote) { %>, url('<%- url_for(fallbackBg) %>')<% } %>"<% } %>>
  <div class="masthead-overlay" aria-hidden="true"></div>
  <div class="masthead-container">
    <div class="masthead-inner">
      <% if (kind === 'post') { %>
        <div class="post-heading">
          <div class="post-title-line">
            <h1><%- formatTitle(heading) %></h1>
            <% if (postStats && postStats.wordCount) { %>
              <span class="post-reading-stats" aria-label="文章字数和预计阅读时间">
                <span>字数 <%= formatNumber(postStats.wordCount) %></span>
                <span>预计阅读 <%= postStats.readingMinutes %> 分钟</span>
              </span>
            <% } %>
          </div>
          <% if (subheading) { %><h2 class="subheading"><%- formatTitle(subheading) %></h2><% } %>
          <span class="meta">
            <%= __('post.posted_by') %>
            <a href="<%- url_for('/about/') %>"><%= displayAuthor %></a>
            <%= __('post.posted_on') %>
            <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, config.date_format) %></time>
          </span>
        </div>
      <% } else if (kind === 'site') { %>
        <div class="site-heading">
          <h1><%- formatTitle(heading) %></h1>
          <% if (subheading) { %><span class="subheading"><%- formatTitle(subheading) %></span><% } %>
        </div>
      <% } else { %>
        <div class="page-heading">
          <h1><%- formatTitle(heading) %></h1>
          <% if (subheading) { %><span class="subheading"><%- formatTitle(subheading) %></span><% } %>
        </div>
      <% } %>
    </div>
  </div>
</header>
